# =================================================================
# EuaConnecta 2.0 - Environment Variables Configuration
# =================================================================
# Copy this file to .env.local and fill in the values

# =================================================================
# APPLICATION SETTINGS
# =================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="EuaConnecta 2.0"
NEXT_PUBLIC_APP_VERSION="2.0.0"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
DATABASE_URL="postgresql://euaconecta:euaconecta123@localhost:5432/euaconecta_dev?schema=public"
DIRECT_URL="postgresql://euaconecta:euaconecta123@localhost:5432/euaconecta_dev?schema=public"

# =================================================================
# AUTHENTICATION & SECURITY
# =================================================================
# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# bcrypt Configuration
BCRYPT_ROUNDS=12

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your-nextauth-secret-key-change-this-in-production"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# =================================================================
# PAYMENT PROCESSORS
# =================================================================
# Stripe
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"

# PIX (Brazilian Payment)
PIX_API_KEY=""
PIX_API_SECRET=""
PIX_WEBHOOK_SECRET=""

# Boleto
BOLETO_API_KEY=""
BOLETO_API_SECRET=""

# =================================================================
# EMAIL CONFIGURATION
# =================================================================
# SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# Email Templates
EMAIL_FROM="noreply@euaconecta.com"
EMAIL_FROM_NAME="EuaConnecta"

# SendGrid (Alternative)
SENDGRID_API_KEY=""

# =================================================================
# STORAGE CONFIGURATION
# =================================================================
# MinIO/S3 Configuration
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="euaconecta"
MINIO_SECRET_KEY="euaconecta123"
MINIO_BUCKET_PACKAGES="packages"
MINIO_BUCKET_DOCUMENTS="documents"
MINIO_BUCKET_AVATARS="avatars"
MINIO_BUCKET_BACKUPS="backups"

# AWS S3 (Production)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# =================================================================
# CACHE & SESSION STORAGE
# =================================================================
# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# Session Configuration
SESSION_SECRET="your-session-secret-key-change-this-in-production"
SESSION_MAX_AGE=86400000

# =================================================================
# EXTERNAL APIs
# =================================================================
# Shipping Carriers APIs
FEDEX_API_KEY=""
FEDEX_API_SECRET=""
UPS_API_KEY=""
UPS_API_SECRET=""
DHL_API_KEY=""
DHL_API_SECRET=""

# Address Validation
GOOGLE_MAPS_API_KEY=""

# Currency Exchange
EXCHANGE_RATE_API_KEY=""

# =================================================================
# MONITORING & LOGGING
# =================================================================
# Sentry (Error Tracking)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# DataDog (Monitoring)
DATADOG_API_KEY=""
DATADOG_APP_KEY=""

# Winston Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs/app.log"

# =================================================================
# SECURITY SETTINGS
# =================================================================
# CORS Configuration
CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Helmet Security Headers
HELMET_CONTENT_SECURITY_POLICY="default-src 'self'"
HELMET_HSTS_MAX_AGE=31536000

# CSRF Protection
CSRF_SECRET="your-csrf-secret-here"

# =================================================================
# FEATURE FLAGS
# =================================================================
# Enable/Disable Features
FEATURE_MULTI_CURRENCY=true
FEATURE_CONSOLIDATION=true
FEATURE_INSURANCE=true
FEATURE_TRACKING=true
FEATURE_NOTIFICATIONS=true

# =================================================================
# DEVELOPMENT SETTINGS
# =================================================================
# Debug Mode
DEBUG=true
DEBUG_DATABASE=false
DEBUG_CACHE=false

# Hot Reload
HOT_RELOAD=true

# =================================================================
# PRODUCTION SETTINGS
# =================================================================
# CDN Configuration
CDN_URL=""
CDN_BUCKET=""

# Compression
COMPRESSION_LEVEL=6

# =================================================================
# BACKUP & MAINTENANCE
# =================================================================
# Database Backup
DB_BACKUP_SCHEDULE="0 2 * * *"
DB_BACKUP_RETENTION_DAYS=30

# Log Rotation
LOG_ROTATION_MAX_SIZE="20m"
LOG_ROTATION_MAX_FILES=14

# =================================================================
# THIRD-PARTY INTEGRATIONS
# =================================================================
# Analytics
GOOGLE_ANALYTICS_ID=""
MIXPANEL_TOKEN=""

# Customer Support
INTERCOM_APP_ID=""
ZENDESK_KEY=""

# =================================================================
# COMPLIANCE & LEGAL
# =================================================================
# GDPR Compliance
GDPR_ENABLED=true
COOKIE_CONSENT_REQUIRED=true

# Data Retention
USER_DATA_RETENTION_DAYS=2555
LOG_RETENTION_DAYS=90

# =================================================================
# PERFORMANCE OPTIMIZATION
# =================================================================
# Next.js Configuration
NEXT_PUBLIC_REVALIDATE_TIME=3600
NEXT_IMAGE_OPTIMIZATION=true

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# =================================================================
# TESTING CONFIGURATION
# =================================================================
# Test Database
TEST_DATABASE_URL="postgresql://test:test@localhost:5433/euaconecta_test"

# Test Email
TEST_EMAIL_RECIPIENT="test@euaconecta.com"

# Mock Services
MOCK_EXTERNAL_APIS=true
MOCK_PAYMENT_PROCESSORS=true

# =================================================================
# CONTAINER & DEPLOYMENT
# =================================================================
# Docker Configuration
DOCKER_REGISTRY=""
DOCKER_IMAGE_TAG="latest"

# Kubernetes
K8S_NAMESPACE="euaconecta"
K8S_INGRESS_CLASS="nginx"

# =================================================================
# ADMIN SETTINGS
# =================================================================
# Admin Panel
ADMIN_EMAIL="admin@euaconecta.com"
ADMIN_PASSWORD="change-this-password"

# Emergency Contacts
EMERGENCY_EMAIL="emergency@euaconecta.com"
EMERGENCY_PHONE="+55 11 99999-9999"

# =================================================================
# LEGACY MIGRATION
# =================================================================
# Migration Flags
MIGRATE_FROM_V1=false
MIGRATION_BATCH_SIZE=1000
MIGRATION_TIMEOUT=300000
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs/app.log"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# File Upload
MAX_FILE_SIZE="10485760"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# Monitoring
SENTRY_DSN=""
DATADOG_API_KEY=""

# Development
DEBUG="true"
ENABLE_SWAGGER="true"