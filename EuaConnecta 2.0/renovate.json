{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreUnstable",
    "group:monorepos",
    "group:recommended",
    "workarounds:all"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 4am on Monday"],
  "labels": ["dependencies", "automated"],
  "commitMessagePrefix": "deps:",
  "commitMessageTopic": "{{depName}}",
  "packageRules": [
    {
      "description": "Group React packages",
      "groupName": "React packages",
      "matchPackagePatterns": ["^react", "^@types/react"]
    },
    {
      "description": "Group Next.js packages",
      "groupName": "Next.js packages",
      "matchPackagePatterns": ["^next", "^@next"]
    },
    {
      "description": "Group Prisma packages",
      "groupName": "Prisma packages",
      "matchPackagePatterns": ["^prisma", "^@prisma"]
    },
    {
      "description": "Group testing packages",
      "groupName": "Testing packages",
      "matchPackagePatterns": ["^jest", "^@testing-library", "^@types/jest"]
    },
    {
      "description": "Group ESLint packages",
      "groupName": "ESLint packages",
      "matchPackagePatterns": ["^eslint", "^@typescript-eslint"]
    },
    {
      "description": "Automerge patch updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Require manual approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require manual approval for Next.js major updates",
      "matchPackageNames": ["next"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require manual approval for React major updates",
      "matchPackageNames": ["react", "react-dom"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require manual approval for TypeScript major updates",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on Monday"]
  },
  "npm": {
    "audit": true
  }
}